rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('preferredDialect' in data) || (data.preferredDialect is string && data.preferredDialect.size() <= 30)) &&
             (!('appearance' in data) || (data.appearance in ['light', 'dark', 'system']));
    }

    // Validation helper for SavedPhrase
    function isValidSavedPhrase(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.sourceText is string && data.sourceText.size() <= 2000 &&
             data.targetText is string && data.targetText.size() <= 2000 &&
             data.sourceLang is string && data.sourceLang.size() <= 30 &&
             data.targetLang is string && data.targetLang.size() <= 30 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Strict PII protection: no cross-user scanning
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private User Phrasebook Subcollection
      match /saved_phrases/{phraseId} {
        allow read: if isOwner(userId) && isValidId(userId) && isValidId(phraseId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(phraseId) && isValidSavedPhrase(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(phraseId) && isValidSavedPhrase(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(phraseId);
      }
    }
  }
}
